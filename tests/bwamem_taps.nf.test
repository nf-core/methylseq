nextflow_pipeline {

    name "Test Workflow main.nf - BWA-MEM with TAPS"
    script "../main.nf"
    config "./nextflow.config"
    tag "cpu"

    test("Params: bwamem | taps") {
        when {
            params {
                aligner = "bwamem"
                taps    = true
                outdir  = "$outputDir"
            }
        }

        then {
                def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}', 'multiqc/*/multiqc_plots', 'multiqc/*/multiqc_plots/**', '**/multiqc.parquet'])
                def stable_path = getAllFilesFromDir(params.outdir, ignore: ['**/multiqc.parquet'], ignoreFile: 'tests/.nftignore')
            def bam_files  = getAllFilesFromDir(params.outdir, include: ['**/*.bam'])
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_methylseq_software_mqc_versions.yml"),
                    stable_name,
                    stable_path,
                    bam_files.collect{ file -> [ file.getName(), bam(file.toString()).getReadsMD5() ] }
                ).match() }
            )
        }
    }

    test("Params: bwamem | taps | skip_deduplication") {
        when {
            params {
                aligner            = "bwamem"
                taps               = true
                skip_deduplication = true
                outdir             = "$outputDir"
            }
        }

        then {
            // TAPS calling reads the alignment BAM and its index straight from alignment
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}', 'multiqc/*/multiqc_plots', 'multiqc/*/multiqc_plots/**', '**/multiqc.parquet'])
            def stable_path = getAllFilesFromDir(params.outdir, ignore: ['**/multiqc.parquet'], ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success },
                { assert !file("$outputDir/bwamem/deduplicated").exists() },
                { assert file("$outputDir/rastair/call").listFiles().size() > 0 },
                { assert snapshot(
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_methylseq_software_mqc_versions.yml"),
                    stable_name,
                    stable_path
                ).match() }
            )
        }
    }

}
