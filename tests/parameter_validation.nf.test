nextflow_pipeline {
    name "Test Workflow main.nf - parameter validation errors"
    script "../main.nf"
    config "./nextflow.config"
    tag "cpu"

    // Combinations the pipeline can't run: each must stop at launch with a message naming the problem
    def errorScenarios = [
        [
            description: "Params: bwamem3 | non_directional - not supported",
            params: [ aligner: "bwamem3", non_directional: true ],
            message: "--aligner bwamem3 only supports directional libraries: --non_directional not supported"
        ],
        [
            description: "Params: bwamem3 | zymo - not supported",
            params: [ aligner: "bwamem3", zymo: true ],
            message: "--aligner bwamem3 only supports directional libraries: --zymo not supported"
        ],
        [
            description: "Params: bwamem3 | single_cell - not supported",
            params: [ aligner: "bwamem3", single_cell: true ],
            message: "--aligner bwamem3 only supports directional libraries: --single_cell not supported"
        ],
        [
            // No --aligner: --taps defaults to bwa-mem3, which only aligns directional libraries
            description: "Params: taps (default aligner bwamem3) | non_directional - not supported",
            params: [ taps: true, non_directional: true ],
            message: "--aligner bwamem3 only supports directional libraries: --non_directional not supported"
        ],
        [
            description: "Params: bismark_hisat | taps - not supported",
            params: [ aligner: "bismark_hisat", taps: true ],
            message: "--taps is not supported with --aligner bismark_hisat"
        ],
        [
            description: "Params: bismark_hisat | illumina_5base - not supported",
            params: [ aligner: "bismark_hisat", illumina_5base: true ],
            message: "--illumina_5base is not supported with --aligner bismark_hisat"
        ],
        [
            description: "Params: illumina_5base | taps - not supported",
            params: [ illumina_5base: true, taps: true ],
            message: "--taps and --illumina_5base can't be combined"
        ],
        [
            description: "Params: bismark | illumina_5base | non_directional - not supported",
            params: [ aligner: "bismark", illumina_5base: true, non_directional: true ],
            message: "--non_directional can't be combined with --illumina_5base --aligner bismark"
        ],
        [
            description: "Params: bismark | taps | local_alignment - not supported",
            params: [ aligner: "bismark", taps: true, local_alignment: true ],
            message: "--local_alignment can't be combined with --taps --aligner bismark"
        ],
        [
            description: "Params: bwameth | methyl_kit | run_targeted_sequencing - not supported",
            params: [ aligner: "bwameth", methyl_kit: true, run_targeted_sequencing: true ],
            message: "--methyl_kit can't be combined with --run_targeted_sequencing"
        ],
        [
            description: "Params: bwamem | run_methurator - not supported",
            params: [ aligner: "bwamem", run_methurator: true ],
            message: "--run_methurator is not supported with TAPS data"
        ],
        [
            description: "Params: bismark | run_targeted_sequencing without target_regions_file",
            params: [ aligner: "bismark", run_targeted_sequencing: true, target_regions_file: null ],
            message: "--target_regions_file must be specified"
        ],
        [
            // Two BEDs with the same file name would write the same panel files
            description: "Params: bismark | run_targeted_sequencing with two BEDs of the same name",
            params: [ aligner: "bismark", run_targeted_sequencing: true, target_regions_file: "panel_one/targets.bed,panel_two/targets.bed.gz" ],
            message: "--target_regions_file: each BED needs its own file name, which (without .bed or .bed.gz) labels its results. Used more than once: targets."
        ],
        [
            description: "Params: bismark | run_targeted_sequencing with a dot in a panel name",
            params: [ aligner: "bismark", run_targeted_sequencing: true, target_regions_file: "panels/promoters.v2.bed,panels/enhancers.bed" ],
            message: "may only hold letters, digits, '_' and '-'. Rename: panels/promoters.v2.bed."
        ],
        [
            description: "Params: bismark | run_targeted_sequencing | run_methylation_summary with panel names that differ only in case",
            params: [ aligner: "bismark", run_targeted_sequencing: true, run_methylation_summary: true, target_regions_file: "panels/Promoters.bed,panels/promoters.bed" ],
            message: "panel names must still differ when lower-cased and with '-' read as '_'. Rename one of: Promoters and promoters."
        ],
        [
            description: "Params: bwamem3 | bwamem3_index .tgz - not supported",
            params: [ aligner: "bwamem3", bwamem3_index: "https://github.com/nf-core/test-datasets/raw/methylseq/reference/Bwamem3_Index.tgz" ],
            message: "is an archive format the pipeline can't unpack"
        ],
        [
            description: "Params: bwamem3 | bwamem3_index prefix with missing files",
            params: [ aligner: "bwamem3", bwamem3_index: "https://github.com/nf-core/test-datasets/raw/methylseq/reference/genome.fa" ],
            message: "treated 'https://github.com/nf-core/test-datasets/raw/methylseq/reference/genome.fa' as an index prefix, but these files are missing"
        ],
        [
            description: "Params: bwamem3 | bwamem3_index URL with a query string",
            params: [ aligner: "bwamem3", bwamem3_index: "https://github.com/nf-core/test-datasets/raw/methylseq/reference/Bwamem3_Index.tar.gz?download=1" ],
            message: "has a query string"
        ],
        [
            description: "Params: bismark | local_alignment | relax_mismatches - not supported",
            params: [ aligner: "bismark", local_alignment: true, relax_mismatches: true ],
            message: "--relax_mismatches can't be combined with --local_alignment for --aligner bismark"
        ],
        [
            description: "Params: bismark | bismark_index without fasta",
            params: [ aligner: "bismark", fasta: null, fasta_index: null, bismark_index: "https://github.com/nf-core/test-datasets/raw/methylseq/reference/Bowtie2_Index.tar.gz" ],
            message: "No reference FASTA"
        ],
        [
            description: "Params: bwamem3 | bwamem3_index without fasta",
            params: [ aligner: "bwamem3", fasta: null, fasta_index: null, bwamem3_index: "https://github.com/nf-core/test-datasets/raw/methylseq/reference/Bwamem3_Index.tar.gz" ],
            message: "No reference FASTA"
        ],
        [
            // A fasta set to null wins over --genome; validation is off so the iGenomes S3 paths aren't checked
            description: "Params: genome | fasta set to null",
            params: [ genome: "GRCh38", fasta: null, fasta_index: null, validate_params: false ],
            message: "No reference FASTA"
        ],
        [
            // Validation is off so the schema's fasta pattern and exists checks don't fire first
            description: "Params: bismark | illumina_5base | fasta not named .fa - not supported",
            params: [ aligner: "bismark", illumina_5base: true, fasta: "https://github.com/nf-core/test-datasets/raw/methylseq/reference/genome.fna.gz", fasta_index: null, validate_params: false ],
            message: "needs a FASTA named *.fa or *.fasta"
        ],
        [
            // Bismark only finds a FASTA named *.fa or *.fasta (optionally .gz) in a genome folder
            description: "Params: bismark | control_fasta not named .fa - not supported",
            params: [ aligner: "bismark", control_fasta: "https://github.com/nf-core/test-datasets/raw/methylseq/testdata/SRR389222_sub1.fastq.gz" ],
            message: "does not match regular expression ^\\S+\\.fa(sta)?(\\.gz)?\$"
        ],
        [
            description: "Params: bismark | slamseq - removed",
            params: [ aligner: "bismark", slamseq: true ],
            message: "--slamseq was removed in 5.0.0: Bismark 3.x has no SLAM-seq mode."
        ],
        [
            description: "Params: bwameth | slamseq - removed",
            params: [ aligner: "bwameth", slamseq: true ],
            message: "--slamseq was removed in 5.0.0: Bismark 3.x has no SLAM-seq mode."
        ],
        [
            // An unknown genome and no FASTA would each stop the run too: --slamseq is reported first
            description: "Params: slamseq | unknown genome, no FASTA - removed is reported first",
            params: [ slamseq: true, genome: "not_a_genome", fasta: null, fasta_index: null, validate_params: false ],
            message: "--slamseq was removed in 5.0.0: Bismark 3.x has no SLAM-seq mode."
        ]
    ]

    test("Params: bismark | options for other steps - warn and run") {
        when {
            params {
                outdir                   = "${outputDir}"
                aligner                  = "bismark"
                trim_OT                  = "0,0,10,0"
                collecthsmetrics         = true
                bwamem3_index            = "https://github.com/nf-core/test-datasets/raw/methylseq/reference/Bwamem3_Index.tar.gz"
                five_base_baseq          = 30
            }
        }

        then {
            def log_text = file("${metaDir}/nextflow.log").text
            assertAll(
                { assert workflow.success },
                { assert log_text.contains('--trim_OT/--trim_OB only apply to rastair calls') },
                { assert log_text.contains('--collecthsmetrics only applies with --run_targeted_sequencing') },
                { assert log_text.contains('--bwamem3_index only applies to --aligner bwamem3') },
                { assert log_text.contains("--five_base_baseq only applies to Bismark's 5-Base/TAPS mode (--illumina_5base or --taps with --aligner bismark). It is ignored") },
                { assert snapshot(
                    removeNextflowVersion("${outputDir}/pipeline_info/nf_core_methylseq_software_mqc_versions.yml"),
                ).match() }
            )
        }
    }

    test("Params: bismark | input named like Trim Galore's raw FastQC alias - stops at the samplesheet") {
        when {
            def fixture = new File("${outputDir}/../raw_alias_fixture")
            fixture.mkdirs()
            def fastq = new File(fixture, "S1_raw.fastq.gz")
            new java.util.zip.GZIPOutputStream(new FileOutputStream(fastq)).withWriter('UTF-8') { writer -> writer.write("@r1\nACGT\n+\nIIII\n") }
            def samplesheet = new File(fixture, "samplesheet.csv")
            samplesheet.text = "sample,fastq_1,fastq_2,genome\nS1,${fastq.absolutePath},,\n"
            params {
                outdir = "${outputDir}"
                input  = samplesheet.absolutePath
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { line -> line.contains("the name Trim Galore uses for its raw FastQC report") } }
            )
        }
    }

    test("Params: samplesheet genome column filled - not used") {
        when {
            params {
                outdir = "${outputDir}"
                input  = "${projectDir}/tests/samplesheet_genome_column.csv"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { line -> line.contains("The samplesheet 'genome' column is not used") } }
            )
        }
    }

    test("Params: bismark | illumina_5base | single-end sample - not supported") {
        when {
            params {
                outdir         = "${outputDir}"
                input          = "${projectDir}/assets/samplesheet_taps.csv"
                fasta          = "https://github.com/nf-core/test-datasets/raw/methylseq/reference/genome_taps.fa.gz"
                fasta_index    = "https://github.com/nf-core/test-datasets/raw/methylseq/reference/genome_taps.fa.fai"
                aligner        = "bismark"
                illumina_5base = true
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { line -> line.contains("sample taps_se is single-end: Bismark's 5-Base/TAPS mode") } },
                // stops when the samplesheet is read, before any alignment
                { assert workflow.trace.tasks().every { task -> !task.name.contains('BISMARK_ALIGN') } }
            )
        }
    }

    errorScenarios.each { scenario ->
        test(scenario.description) {
            when {
                params {
                    outdir = "${outputDir}"
                    scenario.params.each { key, value ->
                        delegate."$key" = value
                    }
                }
            }

            then {
                assertAll(
                    { assert workflow.failed },
                    { assert (workflow.stdout + workflow.stderr).any { line -> line.contains(scenario.message) } }
                )
            }
        }
    }
}
