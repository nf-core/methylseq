nextflow_pipeline {

    name "Test Workflow main.nf - bwa-mem3 with TAPS"
    script "../main.nf"
    config "./nextflow.config"
    tag "cpu"

    test("Params: bwamem3 | taps") {
        // same params as -profile test_taps, which tests/nextflow.config would override (it sets input and fasta for every test)
        when {
            params {
                input       = "${projectDir}/assets/samplesheet_taps.csv"
                fasta       = "https://github.com/nf-core/test-datasets/raw/methylseq/reference/genome_taps.fa.gz"
                fasta_index = "https://github.com/nf-core/test-datasets/raw/methylseq/reference/genome_taps.fa.fai"
                aligner     = "bwamem3"
                taps        = true
                outdir      = "$outputDir"
            }
        }

        then {
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}', 'multiqc/*/multiqc_plots', 'multiqc/*/multiqc_plots/**', '**/multiqc.parquet'])
            // the M-bias PDF embeds its creation date
            def stable_path = getAllFilesFromDir(params.outdir, ignore: ['**/multiqc.parquet', 'rastair/mbiasparser/*.pdf'], ignoreFile: 'tests/.nftignore')
            def bam_files   = getAllFilesFromDir(params.outdir, include: ['**/*.bam'])
            // pooled methylation per contig, from rows of [ contig, methylated, covered ]
            def pooledMethylation = { rows ->
                rows.groupBy { row -> row[0] }.collectEntries { contig, contig_rows ->
                    [ (contig): contig_rows.sum { row -> row[1] } / contig_rows.sum { row -> row[2] } ]
                }
            }
            // methylKit columns: chrBase, chr, base, strand, coverage, freqC, freqT
            def methylation = pooledMethylation(
                path("$outputDir/rastair/methylkit/taps_pe.rastair_methylkit.txt.gz").linesGzip.drop(1).collect { line ->
                    def fields = line.split('\t')
                    [ fields[1], (fields[4] as double) * (fields[5] as double) / 100, fields[4] as double ]
                }
            )
            assertAll(
                { assert workflow.success },
                { assert file("${metaDir}/nextflow.log").text.contains('get no methylation calls: taps_se') },
                // TAPS reads methylated C as T: the methylated lambda spike-in should be high and the unmodified one low
                { assert methylation.keySet().containsAll(['bacteriophage_lambda_CpG', '2kb_3_Unmodified']) },
                { assert methylation['bacteriophage_lambda_CpG'] > 0.8 },
                { assert methylation['2kb_3_Unmodified'] < 0.1 },
                { assert snapshot(
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_methylseq_software_mqc_versions.yml"),
                    stable_name,
                    stable_path,
                    bam_files.collect { file -> [ file.getName(), bam(file.toString()).getReadsMD5() ] }
                ).match() }
            )
        }
    }

    test("Params: bwamem3 | taps | trim_OT, trim_OB") {
        when {
            params {
                input       = "${projectDir}/assets/samplesheet_taps.csv"
                fasta       = "https://github.com/nf-core/test-datasets/raw/methylseq/reference/genome_taps.fa.gz"
                fasta_index = "https://github.com/nf-core/test-datasets/raw/methylseq/reference/genome_taps.fa.fai"
                aligner     = "bwamem3"
                taps        = true
                trim_OT     = "0,0,10,0"
                trim_OB     = "0,0,3,0"
                outdir      = "$outputDir"
            }
        }

        then {
            // rastair 0.8 call does not record its command line, so read it from the task scripts
            def call_scripts = []
            new File(workDir.toString()).eachFileRecurse { script ->
                if (script.name == '.command.sh' && script.text.contains('rastair call')) {
                    call_scripts << script.text
                }
            }
            assertAll(
                { assert workflow.success },
                // given trims replace the M-bias estimate
                { assert !file("$outputDir/rastair/mbias").exists() },
                { assert !file("$outputDir/rastair/mbiasparser").exists() },
                // with given trims, rastair 0.8 call runs for both samples (taps_pe and taps_se)
                { assert call_scripts.size() == 2 },
                { assert call_scripts.every { script -> script.contains('--nOT 0,0,10,0') && script.contains('--nOB 0,0,3,0') } }
            )
        }
    }

    test("Params: bwamem3 | taps | taps_caller rastair2") {
        when {
            params {
                input                    = "${projectDir}/assets/samplesheet_taps.csv"
                fasta                    = "https://github.com/nf-core/test-datasets/raw/methylseq/reference/genome_taps.fa.gz"
                fasta_index              = "https://github.com/nf-core/test-datasets/raw/methylseq/reference/genome_taps.fa.fai"
                aligner                  = "bwamem3"
                taps                     = true
                taps_caller              = "rastair2"
                accept_rastair2_license  = true
                // chr19 is the only chromosome-like contig, so the genome-wide figures are the same with or without it
                rastair2_control_contigs = "bacteriophage_lambda_CpG,2kb_3_Unmodified"
                outdir                   = "$outputDir"
            }
        }

        then {
            // RASTAIR2_SUMMARY task scripts, to check that --rastair2_control_contigs reaches the script
            def summary_scripts = []
            new File(workDir.toString()).eachFileRecurse { script ->
                if (script.name == '.command.sh' && script.text.contains('rastair2_summary.sh')) {
                    summary_scripts << script.text
                }
            }
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}', 'multiqc/*/multiqc_plots', 'multiqc/*/multiqc_plots/**', '**/multiqc.parquet'])
            // the M-bias HTML report embeds its plots; the VCF header records --threads, so VCFs are compared on their records
            def stable_path = getAllFilesFromDir(params.outdir, ignore: ['**/multiqc.parquet', 'rastair2/mbias/*.html', 'rastair2/call/*.vcf.gz', 'rastair2/call/*.vcf.gz.tbi'], ignoreFile: 'tests/.nftignore')
            def vcf_records = getAllFilesFromDir(params.outdir, include: ['rastair2/call/*.vcf.gz']).collect { vcf ->
                [ vcf.getName(), path(vcf.toString()).linesGzip.findAll { line -> !line.startsWith('##') }.join('\n').md5() ]
            }
            def general_stats = new groovy.json.JsonSlurper()
                .parse(new File("$outputDir/multiqc/bwamem3/multiqc_data/multiqc_data.json"))
                .report_general_stats_data.custom_content
                .collectEntries { sample, columns -> [ (sample): columns.findAll { column, value -> column.startsWith('rastair2_') } ] }
            def bam_files   = getAllFilesFromDir(params.outdir, include: ['**/*.bam'])
            // pooled methylation per contig, from rows of [ contig, methylated, covered ]
            def pooledMethylation = { rows ->
                rows.groupBy { row -> row[0] }.collectEntries { contig, contig_rows ->
                    [ (contig): contig_rows.sum { row -> row[1] } / contig_rows.sum { row -> row[2] } ]
                }
            }
            // CpG BED columns: chr, start, end, name, beta_est, strand, unmod, mod, ..., cpg (REF for reference CpGs)
            def methylation = pooledMethylation(
                path("$outputDir/rastair2/call/taps_pe.bed.gz").linesGzip.findAll { line -> !line.startsWith('#') }.collect { line ->
                    def fields = line.split('\t')
                    [ fields[0], fields[7] as double, (fields[6] as double) + (fields[7] as double) ]
                }
            )
            assertAll(
                { assert workflow.success },
                { assert methylation.keySet().containsAll(['bacteriophage_lambda_CpG', '2kb_3_Unmodified']) },
                { assert methylation['bacteriophage_lambda_CpG'] > 0.8 },
                { assert methylation['2kb_3_Unmodified'] < 0.1 },
                { assert file("$outputDir/rastair2/mbias/taps_pe.mbias.html").exists() },
                { assert !file("$outputDir/rastair2/mbias/taps_se.mbias.html").exists() },
                { assert general_stats.keySet().sort() == ['taps_pe', 'taps_se'] && general_stats.every { sample, columns -> columns.keySet() == ['rastair2_cpg_meth', 'rastair2_cpg_sites', 'rastair2_cpg_depth'] as Set } },
                { assert summary_scripts.size() == 2 && summary_scripts.every { script -> script.contains("-c 'bacteriophage_lambda_CpG,2kb_3_Unmodified' -- ") } },
                { assert !file("${metaDir}/nextflow.log").text.contains('--rastair2_control_contigs only applies') },
                { assert snapshot(
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_methylseq_software_mqc_versions.yml"),
                    stable_name,
                    stable_path,
                    vcf_records,
                    general_stats,
                    bam_files.collect { file -> [ file.getName(), bam(file.toString()).getReadsMD5() ] }
                ).match() }
            )
        }
    }

    test("Params: bwamem3 | taps | taps_caller rastair2 | trim_OT, trim_OB") {
        when {
            params {
                input                   = "${projectDir}/assets/samplesheet_taps.csv"
                fasta                   = "https://github.com/nf-core/test-datasets/raw/methylseq/reference/genome_taps.fa.gz"
                fasta_index             = "https://github.com/nf-core/test-datasets/raw/methylseq/reference/genome_taps.fa.fai"
                aligner                 = "bwamem3"
                taps                    = true
                taps_caller             = "rastair2"
                accept_rastair2_license = true
                trim_OT                 = "0,0,10,0"
                trim_OB                 = "0,0,3,0"
                outdir                  = "$outputDir"
            }
        }

        then {
            def stable_path = getAllFilesFromDir(params.outdir, include: ['rastair2/call/*.bed.gz'])
            assertAll(
                { assert workflow.success },
                { assert !file("$outputDir/rastair2/mbias").exists() },
                { assert path("$outputDir/rastair2/call/taps_pe.vcf.gz").linesGzip.any { line -> line.startsWith('##rastairCommand=') && line.contains('--nOT 0,0,10,0') && line.contains('--nOB 0,0,3,0') } },
                { assert snapshot(stable_path).match() }
            )
        }
    }

    test("Params: bwamem3 | taps | taps_caller rastair2 | trim_OT only") {
        when {
            params {
                input                   = "${projectDir}/assets/samplesheet_taps.csv"
                fasta                   = "https://github.com/nf-core/test-datasets/raw/methylseq/reference/genome_taps.fa.gz"
                fasta_index             = "https://github.com/nf-core/test-datasets/raw/methylseq/reference/genome_taps.fa.fai"
                aligner                 = "bwamem3"
                taps                    = true
                taps_caller             = "rastair2"
                accept_rastair2_license = true
                trim_OT                 = "2,0,2,0"
                outdir                  = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert !file("$outputDir/rastair2/mbias").exists() },
                // an unset --trim_OB means no trimming of OB reads, not the M-bias estimate
                { assert path("$outputDir/rastair2/call/taps_pe.vcf.gz").linesGzip.any { line -> line.startsWith('##rastairCommand=') && line.contains('--nOT 2,0,2,0') && line.contains('--nOB 0,0,0,0') } }
            )
        }
    }

    test("Params: bwamem3 | taps | taps_caller rastair2 - license not accepted") {
        when {
            params {
                aligner     = "bwamem3"
                taps        = true
                taps_caller = "rastair2"
                outdir      = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stdout.any { line -> line.contains('--accept_rastair2_license') } }
            )
        }
    }

}
