nextflow_pipeline {
    name "Test Workflow main.nf - Targeted Sequencing Variants"
    script "../main.nf"
    config "./nextflow.config"
    tag "cpu"

    // Define targeted sequencing test scenarios
    def testScenarios = [
        [
            name: "bismark_run_targeted_sequencing",
            description: "Params: bismark with run_targeted_sequencing",
            params: [
                aligner: "bismark",
                run_targeted_sequencing: true
            ]
        ],
        [
            name: "bwameth_run_targeted_sequencing",
            description: "Params: bwameth with run_targeted_sequencing",
            params: [
                aligner: "bwameth",
                run_targeted_sequencing: true
            ]
        ],
        [
            name: "bwameth_all_contexts_run_targeted_sequencing",
            description: "Params: bwameth with all_contexts and run_targeted_sequencing",
            params: [
                aligner: "bwameth",
                all_contexts: true,
                run_targeted_sequencing: true
            ]
        ],
        [
            name: "bwameth_run_targeted_sequencing_collecthsmetrics",
            description: "Params: bwameth with run_targeted_sequencing and collecthsmetrics",
            params: [
                aligner: "bwameth",
                run_targeted_sequencing: true,
                collecthsmetrics: true
            ]
        ],
        [
            name: "bismark_run_targeted_sequencing_collecthsmetrics",
            description: "Params: bismark with run_targeted_sequencing and collecthsmetrics",
            params: [
                aligner: "bismark",
                run_targeted_sequencing: true,
                collecthsmetrics: true
            ]
        ],
        [
            // coverage2cytosine and targeted outputs are published under bismark_hisat/
            name: "bismark_hisat_cytosine_report_run_targeted_sequencing",
            description: "Params: bismark_hisat with cytosine_report and run_targeted_sequencing",
            params: [
                aligner: "bismark_hisat",
                cytosine_report: true,
                run_targeted_sequencing: true
            ]
        ]
    ]

    // Common assertion function (without workflow access)
    def getStandardAssertionData = { outputDir ->
        def stable_name = getAllFilesFromDir(outputDir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}', 'multiqc/*/multiqc_plots', 'multiqc/*/multiqc_plots/**'])
        def stable_path = getAllFilesFromDir(outputDir, ignoreFile: 'tests/.nftignore')
        def bam_files = getAllFilesFromDir(outputDir, include: ['**/*.bam'])

        return [
            removeNextflowVersion("${outputDir}/pipeline_info/nf_core_methylseq_software_mqc_versions.yml"),
            stable_name,
            stable_path,
            bam_files.collect{ file -> [ file.getName(), bam(file.toString()).getReadsMD5() ] }
        ]
    }

    // Generate tests for each scenario
    testScenarios.each { scenario ->
        test(scenario.description) {
            when {
                params {
                    outdir = "${outputDir}"
                    // Apply scenario-specific parameters
                    scenario.params.each { key, value ->
                        delegate."$key" = value
                    }
                }
            }

            then {
                assertAll(
                    { assert workflow.success },
                    { assert snapshot(
                        *getStandardAssertionData(params.outdir)
                    ).match() }
                )
            }
        }
    }

    // rastair 0.8 and rastair 2 write the same CpG columns under a # header, one row per strand
    def tapsCallers = [
        [
            caller: "rastair2",
            calls: "rastair2/call/taps_pe.bed.gz",
            // the M-bias HTML report embeds its plots; the VCF header records --threads
            ignore: ['**/multiqc.parquet', 'rastair2/mbias/*.html', 'rastair2/call/*.vcf.gz', 'rastair2/call/*.vcf.gz.tbi']
        ],
        [
            caller: "rastair",
            calls: "rastair/call/taps_pe.rastair_call.txt",
            // the M-bias PDF embeds its creation date
            ignore: ['**/multiqc.parquet', 'rastair/mbiasparser/*.pdf']
        ]
    ]

    tapsCallers.each { run ->
        test("Params: bwamem3 | taps | taps_caller ${run.caller} | run_targeted_sequencing | collecthsmetrics") {
            when {
                params {
                    input                   = "${projectDir}/assets/samplesheet_taps.csv"
                    fasta                   = "https://github.com/nf-core/test-datasets/raw/methylseq/reference/genome_taps.fa.gz"
                    fasta_index             = "https://github.com/nf-core/test-datasets/raw/methylseq/reference/genome_taps.fa.fai"
                    target_regions_file     = "${projectDir}/assets/genome_taps_target_regions.bed"
                    aligner                 = "bwamem3"
                    taps                    = true
                    taps_caller             = run.caller
                    accept_rastair2_license = run.caller == "rastair2"
                    run_targeted_sequencing = true
                    collecthsmetrics        = true
                    outdir                  = "$outputDir"
                }
            }

            then {
                def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}', 'multiqc/*/multiqc_plots', 'multiqc/*/multiqc_plots/**', '**/multiqc.parquet'])
                def stable_path = getAllFilesFromDir(params.outdir, ignore: run.ignore, ignoreFile: 'tests/.nftignore')
                def targeted = path("$outputDir/${run.caller}/call/taps_pe.targeted.bed").readLines()
                def targets = path("${projectDir}/assets/genome_taps_target_regions.bed").readLines().collect { line -> line.split('\t') }
                // a row is on target if its CpG overlaps a target: the C (+) and the G (-) of each CpG are separate rows
                def onTarget = { fields ->
                    def cpg_start = (fields[1] as long) - (fields[5] == '-' ? 1 : 0)
                    targets.any { target -> target[0] == fields[0] && cpg_start + 2 > (target[1] as long) && cpg_start < (target[2] as long) }
                }
                def calls = run.calls.endsWith('.gz') ? path("$outputDir/${run.calls}").linesGzip : path("$outputDir/${run.calls}").readLines()
                def records = targeted.findAll { line -> !line.startsWith('#') }
                // split with -1 to keep an empty beta_est
                def expected = calls.findAll { line -> !line.startsWith('#') && onTarget(line.split('\t', -1)) }
                assertAll(
                    { assert workflow.success },
                    // the header names the columns that downstream tools look up
                    { assert targeted[0].startsWith('#') && targeted[0].contains('unmod') },
                    { assert records.size() > 0 },
                    // every on-target row of the full calls is kept, both strands, and nothing else
                    { assert records == expected },
                    { assert file("$outputDir/enrichment_metrics").listFiles().any { metrics -> metrics.name.startsWith('taps_pe') } },
                    { assert snapshot(
                        removeNextflowVersion("$outputDir/pipeline_info/nf_core_methylseq_software_mqc_versions.yml"),
                        stable_name,
                        stable_path
                    ).match() }
                )
            }
        }
    }
}
