nextflow_pipeline {
    name "Test Workflow main.nf - Bismark combined-index alignment"
    script "../main.nf"
    config "./nextflow.config"
    tag "cpu"

    // Combined-index alignment is the default: genome prep builds Bisulfite_Genome/Combined/ and the report names the mode
    def testScenarios = [
        [
            description: "Params: bismark default combined index (directional)",
            params: [ save_reference: true ],
            sequential: false
        ],
        [
            description: "Params: bismark default combined index and non_directional",
            params: [ non_directional: true, save_reference: true ],
            sequential: true
        ],
        [
            description: "Params: bismark default combined index and pbat",
            params: [ pbat: true, save_reference: true ],
            sequential: false
        ],
        [
            description: "Params: bismark_hisat default combined index (directional)",
            params: [ aligner: "bismark_hisat", save_reference: true ],
            sequential: false
        ]
    ]

    // Common assertion function (without workflow access)
    def getStandardAssertionData = { outputDir ->
        def stable_name = getAllFilesFromDir(outputDir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}', 'multiqc/*/multiqc_plots', 'multiqc/*/multiqc_plots/**'])
        def stable_path = getAllFilesFromDir(outputDir, ignoreFile: 'tests/.nftignore')
        def bam_files = getAllFilesFromDir(outputDir, include: ['**/*.bam'])

        return [
            removeNextflowVersion("${outputDir}/pipeline_info/nf_core_methylseq_software_mqc_versions.yml"),
            stable_name,
            stable_path,
            bam_files.collect{ file -> [ file.getName(), bam(file.toString()).getReadsMD5() ] }
        ]
    }
    def alignReports = { outputDir -> getAllFilesFromDir(outputDir, include: ['**/alignments/logs/*_report.txt']) }
    def combinedReference = { outputDir -> getAllFilesFromDir(outputDir, include: ['**/Bisulfite_Genome/Combined/*']) }
    // MultiQC's Bismark alignment mode table, as [sample: mode]
    def alignmentModes = { outputDir ->
        def table = getAllFilesFromDir(outputDir, include: ['multiqc/**/multiqc_bismark_alignment_mode.txt'])
        table ? path(table[0].toString()).readLines().drop(1).collectEntries { line -> def fields = line.split('\t'); [ (fields[0]): fields[1] ] } : [:]
    }
    def testSamples = ['Ecoli_10K_methylated', 'SRR389222_sub1', 'SRR389222_sub2', 'SRR389222_sub3'] as Set
    // The Bismark alignment scripts of the main route
    def alignScripts = { workDir ->
        def scripts = []
        new File(workDir.toString()).eachFileRecurse { script ->
            if (script.name == '.command.sh' && script.text.contains('bismark \\') && script.text.contains('--genome')) {
                scripts << script.text
            }
        }
        scripts
    }

    testScenarios.each { scenario ->
        test(scenario.description) {
            when {
                params {
                    outdir = "${outputDir}"
                    scenario.params.each { key, value ->
                        delegate."$key" = value
                    }
                }
            }

            then {
                def reports = alignReports(params.outdir)
                def scripts = alignScripts(workDir)
                assertAll(
                    { assert workflow.success },
                    { assert combinedReference(params.outdir).size() > 0 },
                    { assert reports.size() > 0 && reports.every { report -> report.text.contains('Combined-index mode') } },
                    { assert scripts.size() > 0 && scripts.every { script -> script.contains('--combined_index') && script.contains('--combined_index_sequential') == scenario.sequential } },
                    { assert alignmentModes(params.outdir).keySet() == testSamples && alignmentModes(params.outdir).values().every { mode -> mode == 'combined index' } },
                    { assert snapshot(
                        *getStandardAssertionData(params.outdir)
                    ).match() }
                )
            }
        }
    }

    test("Params: combined_index false aligns per strand and builds no combined index") {
        when {
            params {
                combined_index = false
                save_reference = true
                outdir         = "${outputDir}"
            }
        }

        then {
            def reports = alignReports(params.outdir)
            assertAll(
                { assert workflow.success },
                { assert combinedReference(params.outdir).isEmpty() },
                { assert reports.size() > 0 && reports.every { report -> (report.text =~ /(^|\s)-p 2(\s|$)/).find() && !report.text.contains('Combined-index mode') } },
                { assert alignmentModes(params.outdir).keySet() == testSamples && alignmentModes(params.outdir).values().every { mode -> mode == 'per strand' } }
            )
        }
    }

    test("Params: local_alignment aligns per strand without a warning") {
        when {
            params {
                local_alignment = true
                save_reference  = true
                outdir          = "${outputDir}"
            }
        }

        then {
            def reports = alignReports(params.outdir)
            assertAll(
                { assert workflow.success },
                { assert combinedReference(params.outdir).isEmpty() },
                { assert reports.size() > 0 && reports.every { report -> !report.text.contains('Combined-index mode') } },
                { assert !file("${metaDir}/nextflow.log").text.contains('so Bismark aligns per strand') }
            )
        }
    }

    // A stub genome prep writes no Combined/ files, so -stub runs take the combined flag without the file check
    test("Params: bismark default combined index - stub") {
        options "-stub"
        when {
            params {
                outdir = "${outputDir}"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().any { task -> task.name.contains('BISMARK_ALIGN') } },
                { assert !file("${metaDir}/nextflow.log").text.contains('so Bismark aligns per strand') }
            )
        }
    }

    test("Params: combined_index true with a pre-built index lacking the combined set stops") {
        when {
            params {
                combined_index = true
                bismark_index  = "https://github.com/nf-core/test-datasets/raw/methylseq/reference/Bowtie2_Index.tar.gz"
                outdir         = "${outputDir}"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { line -> line.contains('--combined_index true: the Bismark index') } || file("${metaDir}/nextflow.log").text.contains('--combined_index true: the Bismark index') },
                { assert !workflow.trace.tasks().any { task -> task.name.contains('BISMARK_ALIGN') } }
            )
        }
    }
}
