nextflow_pipeline {
    name "Test Workflow main.nf - Bismark Variants"
    script "../main.nf"
    config "./nextflow.config"
    tag "cpu"

    // Define bismark test scenarios
    def testScenarios = [
        [
            name: "bismark_default",
            description: "Params: bismark (default)",
            params: [:]
        ],
        [
            name: "bismark_skip_trimming",
            description: "Params: bismark with skip_trimming",
            params: [
                skip_trimming: true
            ]
        ],
        [
            name: "bismark_skip_deduplication",
            description: "Params: bismark with skip_deduplication",
            params: [
                skip_deduplication: true
            ]
        ],
        [
            name: "bismark_cytosine_report",
            description: "Params: bismark with cytosine_report",
            params: [
                cytosine_report: true
            ]
        ],
        [
            name: "bismark_rrbs",
            description: "Params: bismark with rrbs",
            params: [
                rrbs: true
            ]
        ],
        [
            name: "bismark_emseq_clip_r1",
            description: "Params: bismark with em_seq and clip_r1",
            params: [
                em_seq: true,
                clip_r1: 2
            ]
        ],
        [
            name: "bismark_nomeseq",
            description: "Params: bismark with nomeseq",
            params: [
                nomeseq: true
            ]
        ],
        [
            name: "bismark_save_reference_save_align_intermeds_unmapped",
            description: "Params: bismark with save_reference, save_align_intermeds and unmapped",
            params: [
                save_reference: true,
                save_align_intermeds: true,
                unmapped: true
            ]
        ],
        [
            name: "bismark_run_preseq",
            description: "Params: bismark with run_preseq",
            params: [
                run_preseq: true
            ]
        ],
        [
            name: "bismark_run_methurator",
            description: "Params: bismark with run_methurator",
            params: [
                run_methurator: true,
                methurator_minimum_coverage: "1",
                methurator_compute_ci: false
            ]
        ],
        [
            name: "bismark_run_qualimap",
            description: "Params: bismark with run_qualimap",
            params: [
                run_qualimap: true
            ]
        ],
        [
            name: "bismark_skip_multiqc",
            description: "Params: bismark with skip_multiqc",
            params: [
                skip_multiqc: true
            ]
        ],
        [
            name: "bismark_skip_fastqc",
            description: "Params: bismark with skip_fastqc",
            params: [
                skip_fastqc: true
            ]
        ],
        [
            name: "bismark_cat_fastq",
            description: "Params: bismark with CAT_FASTQ",
            params: [
                input: "assets/samplesheet_replicates.csv"
            ]
        ],
        [
            name: "bismark_cat_fastq_skip_trimming_skip_deduplication",
            description: "Params: bismark with CAT_FASTQ and skip_trimming and skip_deduplication",
            params: [
                input: "assets/samplesheet_replicates.csv",
                skip_trimming: true,
                skip_deduplication: true
            ]
        ]
    ]

    // Common assertion function (without workflow access)
    def getStandardAssertionData = { outputDir ->
        def stable_name = getAllFilesFromDir(outputDir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}', 'multiqc/*/multiqc_plots', 'multiqc/*/multiqc_plots/**'])
        def stable_path = getAllFilesFromDir(outputDir, ignoreFile: 'tests/.nftignore')
        def bam_files = getAllFilesFromDir(outputDir, include: ['**/*.bam'])

        return [
            removeNextflowVersion("${outputDir}/pipeline_info/nf_core_methylseq_software_mqc_versions.yml"),
            stable_name,
            stable_path,
            bam_files.collect{ file -> [ file.getName(), bam(file.toString()).getReadsMD5() ] }
        ]
    }

    // Generate tests for each scenario
    testScenarios.each { scenario ->
        test(scenario.description) {
            when {
                params {
                    outdir = "${outputDir}"
                    // Apply scenario-specific parameters
                    scenario.params.each { key, value ->
                        if (key == 'input') {
                            // Handle special case for input files
                            input = "${baseDir}/${value}"
                        } else {
                            delegate."$key" = value
                        }
                    }
                }
            }

            then {
                def snapshotArgs = getStandardAssertionData(params.outdir)
                if (scenario.name == "bismark_run_methurator") {
                    snapshotArgs += getAllFilesFromDir(params.outdir, include: ['methurator/summaries/*.yml'])
                        .collect { file -> [file.getName(), path(file.toString()).readLines()[3..10].join('\n').md5() ] }
                }

                // With trimming, Trim Galore writes the raw and trimmed FastQC reports and FASTQC doesn't run
                def trimgalore_fastqc = !scenario.params.skip_trimming && !scenario.params.skip_fastqc
                def java_fastqc = scenario.params.skip_trimming && !scenario.params.skip_fastqc
                def fastqc_tasks = workflow.trace.tasks().findAll { task -> task.name.contains(':FASTQC (') }
                def align_tasks = workflow.trace.tasks().findAll { task -> task.name.contains(':BISMARK_ALIGN (') }
                def raw_zips = getAllFilesFromDir(params.outdir, include: ['fastqc/zips/*_raw_fastqc.zip'])
                def tg_json = getAllFilesFromDir(params.outdir, include: ['trimgalore/logs/*_trimming_report.json'])
                def trimmed_reports = getAllFilesFromDir(params.outdir, include: ['trimgalore/fastqc/**'])
                def fastqc_files = getAllFilesFromDir(params.outdir, include: ['**/*fastqc*'])
                def trimmed_table = file("${params.outdir}/multiqc/bismark/multiqc_data/multiqc_fastqc_fastqc_trimmed.txt")

                assertAll(
                    { assert workflow.success },
                    // one FASTQC task per sample with --skip_trimming, none otherwise
                    { assert java_fastqc ? (!fastqc_tasks.isEmpty() && fastqc_tasks.size() == align_tasks.size()) : fastqc_tasks.isEmpty() },
                    // one raw report per input read file (Trim Galore writes one JSON report per read file)
                    { assert !trimgalore_fastqc || (!raw_zips.isEmpty() && raw_zips.size() == tg_json.size()) },
                    { assert trimmed_reports.every { report -> !report.getName().contains('_raw_fastqc') } },
                    { assert !scenario.params.skip_fastqc || fastqc_files.isEmpty() },
                    { assert !trimgalore_fastqc || scenario.params.skip_multiqc || (trimmed_table.readLines().size() > 1 && trimmed_table.readLines().drop(1).every { line -> !(line.tokenize('\t')[0] =~ /_(val_[12]|trimmed)$/) }) },
                    { assert snapshot(*snapshotArgs).match() }
                )
            }
        }
    }
}
