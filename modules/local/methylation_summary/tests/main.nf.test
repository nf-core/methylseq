nextflow_process {

    name "Test Process METHYLATION_SUMMARY"
    script "../main.nf"
    process "METHYLATION_SUMMARY"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "methylation_summary"

    // Writes a MethylDackel-style bedGraph (gzipped if the name ends in .gz): `contigs` lists [ contig, positions, mod, unmod ]
    def writeBedGraph = { String path, List contigs ->
        new File(path).parentFile.mkdirs()
        def stream = path.endsWith('.gz') ? new java.util.zip.GZIPOutputStream(new FileOutputStream(path)) : new FileOutputStream(path)
        stream.withWriter { writer ->
            if (!path.endsWith('.gz')) {
                writer << "track type=\"bedGraph\" description=\"sample CpG methylation levels\"\n"
            }
            contigs.each { contig, positions, mod, unmod ->
                (1..positions).each { i -> writer << "${contig}\t${i}\t${i + 1}\t${(100 * mod / (mod + unmod)) as int}\t${mod}\t${unmod}\n" }
            }
        }
        return path
    }

    // Writes a rastair 0.8 call file: `contigs` lists [ contig, CpGs, mod, unmod ], one row per strand
    def writeRastairCalls = { String path, List contigs ->
        new File(path).parentFile.mkdirs()
        new File(path).withWriter { writer ->
            writer << "#chr\tstart\tend\tname\tbeta_est\tstrand\tunmod\tmod\tno_snp\tsnp\tcoverage\tgenotype\tgt_p_score\tgt_conf_score\n"
            contigs.each { contig, cpgs, mod, unmod ->
                (1..cpgs).each { i ->
                    def start = 10 * i
                    writer << "${contig}\t${start}\t${start + 1}\t.\t0.5\t+\t${unmod}\t${mod}\t1\t0\t${mod + unmod}\tC/C\t99\t3\n"
                    writer << "${contig}\t${start + 1}\t${start + 2}\t.\t0.5\t-\t${unmod}\t${mod}\t1\t0\t${mod + unmod}\tG/G\t99\t3\n"
                }
            }
        }
        return path
    }

    def mqcFiles = { out ->
        def files = out.mqc[0][1]
        (files instanceof List ? files : [ files ]).collectEntries { path -> [ (new File(path.toString()).name): path ] }
    }

    def mqcRow = { path ->
        def lines = new File(path.toString()).readLines().findAll { line -> !line.startsWith('#') }
        [lines[0].split('\t') as List, lines[1].split('\t') as List].transpose().collectEntries()
    }

    test("methyldackel - CpG, CHG and CHH with a control contig") {
        when {
            params {
                module_args = '-n methyldackel -c J02459.1'
            }
            process {
                """
                input[0] = channel.of([
                    [ id:'md' ],
                    [
                        file('${writeBedGraph("${outputDir}/input/md_CpG.bedGraph", [['chr1', 20, 6, 4], ['chrM', 20, 0, 10], ['J02459.1', 20, 1, 9]])}', checkIfExists: true),
                        file('${writeBedGraph("${outputDir}/input/md_CHG.bedGraph", [['chr1', 20, 1, 9], ['J02459.1', 20, 5, 5]])}', checkIfExists: true),
                        file('${writeBedGraph("${outputDir}/input/md_CHH.bedGraph", [['chr1', 40, 0, 10], ['J02459.1', 20, 5, 5]])}', checkIfExists: true)
                    ]
                ])
                """
            }
        }

        then {
            def files = mqcFiles(process.out)
            def stats = mqcRow(files['md.methyldackel_generalstats_mqc.tsv'])
            def contigs = mqcRow(files['md.methyldackel_contigs_mqc.tsv'])
            assertAll(
                { assert process.success },
                // chr1 only: not the mitochondrion or the control
                { assert stats == [Sample: 'md', methyldackel_cpg_meth: '60.00', methyldackel_cpg_sites: '20', methyldackel_cpg_depth: '10.00', methyldackel_chg_meth: '10.00', methyldackel_chh_meth: '0.00'] },
                { assert contigs == [Sample: 'md', chr1: '60.00', chrM: '0.00', 'J02459.1': '10.00'] },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("methyldackel - CHH in the sample name, shallow control") {
        when {
            params {
                module_args = '-n methyldackel -c J02459.1'
            }
            process {
                """
                input[0] = channel.of([
                    [ id:'plant_CHH' ],
                    [
                        file('${writeBedGraph("${outputDir}/input/plant_CHH_CpG.bedGraph", [['chr1', 20, 6, 4], ['J02459.1', 3, 1, 9]])}', checkIfExists: true),
                        file('${writeBedGraph("${outputDir}/input/plant_CHH_CHH.bedGraph", [['chr1', 40, 0, 10]])}', checkIfExists: true)
                    ]
                ])
                """
            }
        }

        then {
            def files = mqcFiles(process.out)
            assertAll(
                { assert process.success },
                // the CpG file is read as CpG although the sample name holds CHH
                { assert mqcRow(files['plant_CHH.methyldackel_generalstats_mqc.tsv']) == [Sample: 'plant_CHH', methyldackel_cpg_meth: '60.00', methyldackel_cpg_sites: '20', methyldackel_cpg_depth: '10.00', methyldackel_chh_meth: '0.00'] },
                // a control is listed even with fewer than 10 covered CpGs
                { assert mqcRow(files['plant_CHH.methyldackel_contigs_mqc.tsv']) == [Sample: 'plant_CHH', chr1: '60.00', 'J02459.1': '10.00'] },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("bismark - gzipped coverage file") {
        when {
            params {
                module_args = '-n bismark'
            }
            process {
                """
                input[0] = channel.of([
                    [ id:'bm' ],
                    file('${writeBedGraph("${outputDir}/input/bm.deduplicated.bismark.cov.gz", [['chr', 30, 3, 7]])}', checkIfExists: true)
                ])
                """
            }
        }

        then {
            def files = mqcFiles(process.out)
            def stats = mqcRow(files['bm.bismark_generalstats_mqc.tsv'])
            assertAll(
                { assert process.success },
                // no chromosome-like names: every contig; CpG context only, so no CHG or CHH columns
                { assert stats == [Sample: 'bm', bismark_cpg_meth: '30.00', bismark_cpg_sites: '30', bismark_cpg_depth: '10.00'] },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("labelled panel - hidden General Statistics columns") {
        when {
            params {
                module_args = '-n methyldackel -l Promoters-v2 -H'
            }
            process {
                """
                input[0] = channel.of([
                    [ id:'md' ],
                    file('${writeBedGraph("${outputDir}/input/md_CpG.bedGraph", [['chr1', 20, 6, 4]])}', checkIfExists: true)
                ])
                """
            }
        }

        then {
            def files = mqcFiles(process.out)
            def stats_file = files['md.methyldackel_promoters_v2_generalstats_mqc.tsv']
            def header = new File(stats_file.toString()).readLines().findAll { line -> line.startsWith('#') }
            assertAll(
                { assert process.success },
                { assert files.keySet() == ['md.methyldackel_promoters_v2_beta_hist_mqc.tsv', 'md.methyldackel_promoters_v2_contigs_mqc.tsv', 'md.methyldackel_promoters_v2_generalstats_mqc.tsv'] as Set },
                { assert mqcRow(stats_file).keySet() == ['Sample', 'methyldackel_promoters_v2_cpg_meth', 'methyldackel_promoters_v2_cpg_sites', 'methyldackel_promoters_v2_cpg_depth'] as Set },
                { assert header.count { line -> line.contains('hidden: true') } == 3 },
                { assert header.contains('#         title: "CpG meth (Promoters-v2)"') },
                { assert new File(files['md.methyldackel_promoters_v2_contigs_mqc.tsv'].toString()).text.contains('# section_name: "MethylDackel (Promoters-v2) CpG methylation per contig"') },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("rastair 0.8 - calls with a control contig") {
        when {
            params {
                module_args = '-f rastair -n rastair -c J02459.1'
            }
            process {
                """
                input[0] = channel.of([
                    [ id:'r08' ],
                    file('${writeRastairCalls("${outputDir}/input/r08.rastair_call.txt", [['chr1', 20, 3, 1], ['J02459.1', 20, 0, 4]])}', checkIfExists: true)
                ])
                """
            }
        }

        then {
            def files = mqcFiles(process.out)
            assertAll(
                { assert process.success },
                // every row is a reference CpG strand; the control stays out of the genome-wide figures
                { assert mqcRow(files['r08.rastair_generalstats_mqc.tsv']) == [Sample: 'r08', rastair_cpg_meth: '75.00', rastair_cpg_sites: '40', rastair_cpg_depth: '4.00'] },
                { assert mqcRow(files['r08.rastair_contigs_mqc.tsv']) == [Sample: 'r08', chr1: '75.00', 'J02459.1': '0.00'] },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("methyldackel - targeted bedGraphs, single BED and labelled panel") {
        when {
            params {
                module_args = '-n methyldackel -l panel_a -H'
            }
            process {
                """
                input[0] = channel.of(
                    [
                        [ id:'single' ],
                        [
                            file('${writeBedGraph("${outputDir}/input/single.markdup.sorted_CpG.targeted.bedGraph", [['chr1', 20, 6, 4]])}', checkIfExists: true),
                            file('${writeBedGraph("${outputDir}/input/single.markdup.sorted_CHG.targeted.bedGraph", [['chr1', 20, 1, 9]])}', checkIfExists: true),
                            file('${writeBedGraph("${outputDir}/input/single.markdup.sorted_CHH.targeted.bedGraph", [['chr1', 20, 0, 10]])}', checkIfExists: true)
                        ]
                    ],
                    [
                        [ id:'panel' ],
                        [
                            file('${writeBedGraph("${outputDir}/input/panel.markdup.sorted_CpG.panel_a.targeted.bedGraph", [['chr1', 20, 6, 4]])}', checkIfExists: true),
                            file('${writeBedGraph("${outputDir}/input/panel.markdup.sorted_CHG.panel_a.targeted.bedGraph", [['chr1', 20, 1, 9]])}', checkIfExists: true),
                            file('${writeBedGraph("${outputDir}/input/panel.markdup.sorted_CHH.panel_a.targeted.bedGraph", [['chr1', 20, 0, 10]])}', checkIfExists: true)
                        ]
                    ]
                )
                """
            }
        }

        then {
            def stats = process.out.mqc.collectEntries { meta, files ->
                [ (meta.id): mqcRow(files.find { path -> path.toString().endsWith('generalstats_mqc.tsv') }) ]
            }
            assertAll(
                { assert process.success },
                // the targeted CHG and CHH files keep their context with or without the panel in the name
                { assert ['single', 'panel'].every { sample -> stats[sample] == [Sample: sample, methyldackel_panel_a_cpg_meth: '60.00', methyldackel_panel_a_cpg_sites: '20', methyldackel_panel_a_cpg_depth: '10.00', methyldackel_panel_a_chg_meth: '10.00', methyldackel_panel_a_chh_meth: '0.00'] } }
            )
        }
    }

    test("stub") {
        options "-stub"
        when {
            params {
                module_args = '-n methyldackel'
            }
            process {
                """
                input[0] = channel.of([ [ id:'stub' ], file('${writeBedGraph("${outputDir}/input/stub_CpG.bedGraph", [['chr1', 1, 1, 1]])}', checkIfExists: true) ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
