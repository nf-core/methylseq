/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    EvolvDx profile: production defaults layered on top of nf-core/methylseq
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Use with `-profile evolvdx,<container engine>`. Keeping these defaults in a profile
    (instead of editing nextflow.config) keeps upstream merges clean.
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'EvolvDx profile'
    config_profile_description = 'EvolvDx bwameth/methylKit defaults with EvolvDx QC steps enabled'

    // References
    genome                     = 'grch38_core_bs_controls'
    igenomes_ignore            = true
    cpg_island_bed             = 's3://exosomedx/pipeline_resources/bedfiles/cpgIslandExt.hg38.bed'
    target_regions_file        = 's3://exosomedx/pipeline_resources/bedfiles/covered_targets_Twist_Methylome_hg38_annotated_collapsed.bed'

    // Alignment and extraction
    aligner                    = 'bwameth'
    methyl_kit                 = true

    // Trimming
    clip_r1                    = 20
    clip_r2                    = 15

    // EvolvDx QC steps
    run_methylqc               = true
    run_cpg_coverage           = true
    run_methsnsv               = true
}
