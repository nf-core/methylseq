/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    EvolvDx test profile: small NSQCAM529 subsample, EvolvDx QC steps enabled
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Use with `-profile evolvdx_test,<container engine>`. Pulls its inputs from S3.
----------------------------------------------------------------------------------------
*/

// Start from the EvolvDx production defaults
includeConfig 'evolvdx.config'

process {
    resourceLimits = [
        cpus: 2,
        memory: '6.GB',
        time: '6.h'
    ]
}

params {
    config_profile_name        = 'EvolvDx test profile'
    config_profile_description = 'Minimal EvolvDx test dataset to check pipeline function'

    input = 's3://exosomedx/pipeline_resources/methylseq/test/test_NSQCAM529_subsample_20k.csv'

    // Targeted sequencing metrics against the Twist methylome panel
    run_targeted_sequencing = true
    collecthsmetrics        = true
    run_picardhs_report     = true
}
