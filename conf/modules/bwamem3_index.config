process {
    withName: BWAMEM3_INDEX {
        // `--meth` adds the converted seed index that `bwa-mem3 mem --meth=taps` needs
        ext.args = '--meth'
        // The module has no resource label; its memory scales with the FASTA size
        cpus = { 12 * task.attempt }
        time = { 24.h * task.attempt }
        publishDir = [
            [
                path: { "${params.outdir}/${params.aligner}/reference_genome" },
                mode: params.publish_dir_mode,
                pattern: "*",
                enabled: params.save_reference
            ]
        ]
    }
}
