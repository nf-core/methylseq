process {
    withName: METHYLATION_SUMMARY {
        ext.args = {
            // rastair 0.8 calls on the rastair route; keep in sync with isTaps()
            def rastair = (params.taps || params.illumina_5base || params.aligner == 'bwamem') && !params.aligner.startsWith('bismark')
            [
                rastair ? '-f rastair -n rastair' : params.aligner =~ /bismark/ ? '-n bismark' : '-n methyldackel',
                params.control_contigs ? "-c '${params.control_contigs}'" : '',
            ].join(' ').trim()
        }
        publishDir = [
            enabled: false
        ]
    }

    withName: METHYLATION_SUMMARY_TARGETS {
        ext.args = {
            def tool = params.taps || params.aligner == 'bwamem' ? 'rastair2' : params.aligner =~ /bismark/ ? 'bismark' : 'methyldackel'
            def controls = params.control_contigs ?: (tool == 'rastair2' ? params.rastair2_control_contigs : null)
            [
                tool == 'rastair2' ? '-f rastair2' : '',
                "-n ${tool}",
                // A single BED's name is not checked at launch, but -l only takes letters, digits, '.', '_' and '-'
                "-l '${meta.panel.replaceAll(/[^A-Za-z0-9._-]/, '_')}'",
                '-H',
                controls ? "-c '${controls}'" : '',
            ].findAll().join(' ')
        }
        publishDir = [
            enabled: false
        ]
    }
}
