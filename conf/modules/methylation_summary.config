process {
    withName: METHYLATION_SUMMARY {
        ext.args = {
            [
                params.aligner =~ /bismark/ ? '-n bismark' : '-n methyldackel',
                params.control_contigs ? "-c '${params.control_contigs}'" : '',
            ].join(' ').trim()
        }
        publishDir = [
            enabled: false
        ]
    }
}
