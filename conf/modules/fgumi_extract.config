process {
    withName: FGUMI_EXTRACT {
        // Same read group ID as the aligners write; the module sets the sample to the prefix (meta.id).
        // Without a read structure, the UMI is the last colon-separated field of the read name (e.g. BCL Convert).
        // Single-end samples take the first read structure only.
        ext.args = { "--read-group-id ${meta.id} " + (params.umi_read_structure
            ? "--read-structures ${params.umi_read_structure.tokenize(' ').take(meta.single_end ? 1 : 2).join(' ')}"
            : '--extract-umis-from-read-names') }
        publishDir = [ enabled: false ]
    }
}
