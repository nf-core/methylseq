process {
    withName: BISMARK_ALIGN {
            ext.args = {
                // Opt-in combined-index alignment (params.combined_index, default false).
                // Directional/PBAT -> --combined_index; non-directional -> also
                // --combined_index_sequential (leanest exec model; --non_directional is
                // added below). Incompatible with --local_alignment, so gated off there
                // (the run falls back to the faithful per-strand path).
                def use_combined = (params.aligner =~ /^bismark/) && params.combined_index && !params.local_alignment
                // Spike-in controls (FASTQ_CONTROLS_BISMARK): the library options, end-to-end Bowtie 2, the first control_reads reads
                def controls = meta.controls == true
                def upto = controls && params.control_reads ? "--upto ${params.control_reads}" : ''
                // Bismark's 5-Base/TAPS mode (bismarkBwamem3() in utils_nfcore_methylseq_pipeline): bwa-mem3, only the options in this branch
                if (params.aligner == 'bismark' && (params.taps || params.illumina_5base)) {
                    return [
                        params.taps ? '--taps --bwamem3' : '--illumina_5base --bwamem3',
                        params.five_base_baseq ? "--five_base_baseq ${params.five_base_baseq}" : '',
                        params.unmapped && !controls ? '--unmapped' : '',
                        upto,
                    ].findAll().join(' ')
                }
                [
                    (params.aligner == 'bismark_hisat' && !controls) ? ' --hisat2' : ' --bowtie2',
                    (params.aligner == 'bismark_hisat' && params.known_splices && !controls) ? " --known-splicesite-infile <(hisat2_extract_splice_sites.py ${params.known_splices})" : '',
                    params.pbat ? ' --pbat' : '',
                    ( params.single_cell || params.non_directional || params.zymo ) ? ' --non_directional' : '',
                    use_combined && !controls ? ' --combined_index' : '',
                    ( use_combined && !controls && ( params.single_cell || params.non_directional || params.zymo ) ) ? ' --combined_index_sequential' : '',
                    params.unmapped && !controls ? ' --unmapped' : '',
                    params.relax_mismatches ? " --score_min L,0,-${params.num_mismatches}" : '',
                    params.local_alignment && !controls ? " --local" : '',
                    !meta.single_end && params.minins ? " --minins ${params.minins}" : '',
                    meta.single_end ? '' : (
                        params.maxins ? " --maxins ${params.maxins}" : (
                            params.em_seq ? " --maxins 1000" : ''
                        )
                    ),
                    upto,
                ].join(' ').trim()
            }
            publishDir = [
                [
                    path: { "${params.outdir}/${params.aligner}/alignments/unmapped" },
                    mode: params.publish_dir_mode,
                    pattern: "*.fq.gz",
                    enabled: params.unmapped
                ],
                [
                    path: { "${params.outdir}/${params.aligner}/alignments" },
                    mode: params.publish_dir_mode,
                    pattern: "*.bam",
                    enabled: (params.save_align_intermeds || params.skip_deduplication || params.rrbs)
                ],
                [
                    path: { "${params.outdir}/${params.aligner}/alignments/logs" },
                    mode: params.publish_dir_mode,
                    pattern: "*.txt"
                ]
            ]
        }
}
