process {
    withName: FILTER_BEDGRAPH_TARGETS {
        ext.prefix = { (bedgraph.name =~ /\.(bed\.gz|rastair_call\.txt)$/ ? bedgraph.name - ~/\.(bed\.gz|rastair_call\.txt)$/ : bedgraph.baseName) + (meta.multi_panel ? ".${meta.panel}" : '') }
        publishDir = [
            [
                path: { (params.taps || params.illumina_5base || params.aligner == 'bwamem') && !params.aligner.startsWith('bismark') ? "${params.outdir}/${params.taps_caller}/call" : params.aligner.startsWith('bismark') ? "${params.outdir}/${params.aligner}/methylation_calls/bedGraph" : "${params.outdir}/methyldackel" },
                mode: params.publish_dir_mode,
                pattern: "*.targeted.{bedGraph,bed}"
            ]
        ]
    }
}
