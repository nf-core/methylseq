process {
    withName: FILTER_BEDGRAPH_TARGETS {
        ext.prefix = { bedgraph.name.endsWith('.bed.gz') ? bedgraph.name - ~/\.bed\.gz$/ : bedgraph.baseName }
        publishDir = [
            [
                path: { (params.taps || params.aligner == 'bwamem') ? "${params.outdir}/rastair2/call" : params.aligner.startsWith('bismark') ? "${params.outdir}/${params.aligner}/methylation_calls/bedGraph" : "${params.outdir}/methyldackel" },
                mode: params.publish_dir_mode,
                pattern: "*.targeted.{bedGraph,bed}"
            ]
        ]
    }
}
