process {
    withName: BISMARK_DEDUPLICATE {
        // The UMI is the last colon-separated field of the read name, put there by fgumi fastq
        // UMIs one base apart are grouped with the UMI-tools directional rule; identity needs an exact match
        ext.args = { params.with_umi ? "--barcode --umi_mismatches ${params.umi_dedup_strategy == 'identity' ? 0 : 1}" : '' }
        publishDir = [
            [
                path: { "${params.outdir}/${params.aligner}/deduplicated/logs" },
                mode: params.publish_dir_mode,
                pattern: "*.txt"
            ]
        ]
    }
}
