process {
    withName: RASTAIR2_CALL {
        ext.args = {
            [
                "--nOT ${params.trim_OT}",
                "--nOB ${params.trim_OB}",
                params.non_directional ? '--guess-read-orientation' : '',
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/rastair2/call" },
            mode: params.publish_dir_mode,
            pattern: "*.{vcf.gz,vcf.gz.tbi,bed.gz,bed.gz.tbi}"
        ]
    }
}
