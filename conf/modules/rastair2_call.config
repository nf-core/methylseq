process {
    withName: RASTAIR2_CALL {
        // Trims come from rastair2/mbias or --trim_OT/--trim_OB, passed by BAM_TAPS_CONVERSION
        ext.args = { params.non_directional ? '--guess-read-orientation' : '' }
        publishDir = [
            path: { "${params.outdir}/rastair2/call" },
            mode: params.publish_dir_mode,
            pattern: "*.{vcf.gz,vcf.gz.tbi,bed.gz,bed.gz.tbi}"
        ]
    }

    withName: BCFTOOLS_STATS {
        publishDir = [
            path: { "${params.outdir}/rastair2/bcftools_stats" },
            mode: params.publish_dir_mode,
            pattern: "*stats.txt"
        ]
    }

    withName: RASTAIR2_SUMMARY {
        publishDir = [
            enabled: false
        ]
    }
}
