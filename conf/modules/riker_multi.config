process {
    withName: RIKER_MULTI {
        // No `error` collector: mismatches against the reference are conversions, not sequencing errors
        // Single-end: no insert sizes, and wgs skips unpaired reads unless told otherwise
        ext.args = {
            [
                "--tools alignment basic${meta.single_end ? '' : ' isize'} wgs gcbias${params.run_targeted_sequencing ? ' hybcap' : ''}",
                meta.single_end ? '--wgs::include-unpaired-reads' : '',
                params.run_targeted_sequencing ? '--hybcap::near-distance 500' : '',
            ].findAll().join(' ')
        }
        publishDir = [path: { "${params.outdir}/riker" }, mode: params.publish_dir_mode, pattern: "*.{txt,pdf}"]
    }
}
