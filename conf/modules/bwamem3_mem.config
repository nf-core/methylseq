process {
    withName: BWAMEM3_MEM {
        // `--meth=taps` (the `=` is required) for TAPS; bare `--meth` for bisulfite/EM-seq (unmethylated C->T)
        ext.args = { "${params.taps ? '--meth=taps' : '--meth'} -R '@RG\\tID:${meta.id}\\tSM:${meta.id}\\tLB:${meta.id}\\tPL:ILLUMINA'" }
        ext.prefix = { "${meta.id}.sorted" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/alignments" },
            mode: params.publish_dir_mode,
            pattern: "*.{bam,bai}",
            enabled: params.save_align_intermeds || params.skip_deduplication || params.rrbs
        ]
    }
}
