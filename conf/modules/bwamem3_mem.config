process {
    withName: BWAMEM3_MEM {
        // `--meth=taps` (the `=` is required) aligns 5mC->T converted reads and adds XM/XR/XG tags
        ext.args = { "--meth=taps -R '@RG\\tID:${meta.id}\\tSM:${meta.id}\\tLB:${meta.id}\\tPL:ILLUMINA'" }
        ext.prefix = { "${meta.id}.sorted" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/alignments" },
            mode: params.publish_dir_mode,
            pattern: "*.bam",
            enabled: params.save_align_intermeds || params.skip_deduplication
        ]
    }
}
