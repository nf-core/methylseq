process {
    withName: FGUMI_FASTQ {
        ext.args = { [
            '--no-read-suffix',
            // Bismark deduplicates on the UMI in the read name (deduplicate_bismark --barcode)
            params.aligner.startsWith('bismark') ? '--annotate-read-names' : '',
            meta.single_end ? '' : "--out1 ${meta.id}.umi_extract_1.fastq.gz --out2 ${meta.id}.umi_extract_2.fastq.gz",
        ].join(' ').trim() }
        ext.prefix = { "${meta.id}.umi_extract" }
        publishDir = [ enabled: false ]
    }
}
