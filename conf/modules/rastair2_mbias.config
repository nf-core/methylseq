process {
    withName: RASTAIR2_MBIAS {
        // Arguments for `rastair per-read`. The M-bias report loads every read in range, so it is limited to
        // --rastair2_mbias_region or, by default, the first 10 Mb of the longest contig (read from the .fai at run time).
        ext.args = {
            [
                params.rastair2_mbias_region
                    ? "--region '${params.rastair2_mbias_region}'"
                    : "--region \$(sort -k2,2nr ${fai} | awk 'NR == 1 { print \$1 \":1-\" (\$2 < 10000000 ? \$2 : 10000000) }')",
                params.non_directional ? '--guess-read-orientation' : '',
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/rastair2/mbias" },
            mode: params.publish_dir_mode,
            pattern: "*.{mbias.html,cutoffs.txt}"
        ]
    }
}
