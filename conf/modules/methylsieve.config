process {
    withName: SAMTOOLS_COLLATE {
        // Group mates by read name for methylsieve and drop duplicates; temp files in the work directory, as /tmp can be small
        ext.args = "--input-fmt-option 'filter=!(flag & 0x400)' -T collate_tmp"
        ext.prefix = { "${meta.id}.collated" }
        cpus = 4
        memory = { 4.GB * task.attempt }
        publishDir = [enabled: false]
    }
    withName: METHYLSIEVE {
        // One worker thread; memory is mostly the reference (about 3 GB for human)
        cpus = 2
        memory = { 8.GB * task.attempt }
        // Its BAM is discarded: compress it lightly instead of not at all (the default)
        ext.args = {
            [
                "--chemistry ${params.illumina_5base ? 'illumina-5base' : 'taps'}",
                "--sample ${meta.id}",
                '--mbias-mask',
                '--compression-level 1',
                // checkControlContigs has already stopped the run on any name methylsieve would fail on
                params.control_contigs ? params.control_contigs.tokenize(',').collect { contig -> "--control-contig '${contig}'" }.join(' ') : '',
            ].findAll().join(' ')
        }
        publishDir = [path: { "${params.outdir}/methylsieve" }, mode: params.publish_dir_mode, pattern: "*.{tsv,pdf}"]
    }
}
