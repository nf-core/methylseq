process {
    withName: FILTER_COV_TARGETS {
        ext.prefix = { cov.baseName + (meta.multi_panel ? ".${meta.panel}" : '') }
        publishDir = [
            [
                path: { "${params.outdir}/${params.aligner}/methylation_calls/methylation_coverage" },
                mode: params.publish_dir_mode,
                pattern: "*.targeted.cov"
            ]
        ]
    }
}
