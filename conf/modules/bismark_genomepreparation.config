process {
    withName: BISMARK_GENOMEPREPARATION {
        ext.args = { [
            (params.aligner == 'bismark_hisat') ? ' --hisat2' : ' --bowtie2',
            // The combined CT+GA index for combined-index alignment (--combined_index, auto by default)
            (params.combined_index != false && !params.local_alignment && (params.aligner =~ /^bismark/)) ? ' --combined_genome' : '',
            // Threads per indexer: the CT and GA indexes build at once, the combined index after them
            " --parallel ${Math.max(2, (task.cpus / 2) as int)}",
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/reference_genome" },
            saveAs: { it =~ /.*\.yml/ ? null : it },
            mode: params.publish_dir_mode,
            enabled: params.save_reference
        ]
    }
}
