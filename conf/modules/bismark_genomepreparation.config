process {
    withName: BISMARK_GENOMEPREPARATION {
        ext.args = { [
            (params.aligner == 'bismark_hisat') ? ' --hisat2' : ' --bowtie2',
            params.slamseq ? ' --slam' : '',
            // Opt-in combined-index build (--combined_index alignment needs the combined
            // CT+GA reference). Skipped for --local_alignment (combined rejects --local).
            (params.combined_index && !params.local_alignment && (params.aligner =~ /^bismark/)) ? ' --combined_genome' : ''
        ].join(' ').trim() }
    }
}
