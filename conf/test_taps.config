/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal TAPS tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Mouse TAPS reads (chr19 region plus methylated lambda and unmodified 2 kb spike-ins)
    aligned with bwa-mem3 in TAPS mode.

    Use as follows:
        nextflow run nf-core/methylseq -profile test_taps,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'TAPS test profile'
    config_profile_description = 'Minimal TAPS test dataset to check pipeline function'

    input       = "${projectDir}/assets/samplesheet_taps.csv"
    fasta       = params.pipelines_testdata_base_path + 'reference/genome_taps.fa.gz'
    fasta_index = params.pipelines_testdata_base_path + 'reference/genome_taps.fa.fai'
    aligner     = 'bwamem3'
    taps        = true
}

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}
