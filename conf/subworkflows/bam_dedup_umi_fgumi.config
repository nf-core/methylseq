process {
    withName: 'NFCORE_METHYLSEQ:METHYLSEQ:BAM_DEDUP_UMI_FGUMI:.*' {
        publishDir = [ enabled: false ]
    }

    // fgumi sort needs 1 GiB free in its temp directory, and /tmp is small in some containers
    withName: 'NFCORE_METHYLSEQ:METHYLSEQ:BAM_DEDUP_UMI_FGUMI:FGUMI_SORT_ALIGNED' {
        ext.args = '--order queryname --tmp-dir .'
        ext.prefix = { "${meta.id}.aligned.queryname" }
    }

    withName: 'NFCORE_METHYLSEQ:METHYLSEQ:BAM_DEDUP_UMI_FGUMI:FGUMI_SORT_UNMAPPED' {
        ext.args = '--order queryname --tmp-dir .'
        ext.prefix = { "${meta.id}.unmapped.queryname" }
    }

    withName: 'NFCORE_METHYLSEQ:METHYLSEQ:BAM_DEDUP_UMI_FGUMI:FGUMI_ZIPPER' {
        // Trimming drops reads that end up too short, so the unmapped BAM has reads the alignments lack
        ext.args = '--exclude-missing-reads'
        ext.prefix = { "${meta.id}.zipped" }
    }

    withName: 'NFCORE_METHYLSEQ:METHYLSEQ:BAM_DEDUP_UMI_FGUMI:FGUMI_SORT_TEMPLATE' {
        ext.args = '--order template-coordinate --tmp-dir .'
        ext.prefix = { "${meta.id}.template" }
    }

    withName: 'NFCORE_METHYLSEQ:METHYLSEQ:BAM_DEDUP_UMI_FGUMI:FGUMI_DEDUP' {
        // Keep every record, as Picard MarkDuplicates does: fgumi dedup otherwise drops unmapped and QC-fail templates
        ext.args = { "--strategy ${params.umi_dedup_strategy} --include-unmapped --include-non-pf-reads" }
        ext.prefix = { "${meta.id}.umi_dedup" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/deduplicated/fgumi_metrics" },
            mode: params.publish_dir_mode,
            pattern: "*.txt"
        ]
    }

    withName: 'NFCORE_METHYLSEQ:METHYLSEQ:BAM_DEDUP_UMI_FGUMI:FGUMI_SORT_COORDINATE' {
        ext.args = '--order coordinate --write-index --tmp-dir .'
        ext.prefix = { "${meta.id}.markdup.sorted" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/deduplicated" },
            mode: params.publish_dir_mode,
            pattern: "*.{bam,bai}"
        ]
    }
}
