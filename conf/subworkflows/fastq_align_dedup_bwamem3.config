includeConfig "../modules/bwamem3_mem.config"
includeConfig "../modules/picard_markduplicates.config"
includeConfig "../modules/samtools_stats.config"
includeConfig "../modules/samtools_flagstat.config"
includeConfig "../modules/samtools_idxstats.config"

process {
    // bwa-mem3 writes the alignment BAI itself (published with BWAMEM3_MEM); this indexes the deduplicated BAM
    withName: 'NFCORE_METHYLSEQ:METHYLSEQ:FASTQ_ALIGN_DEDUP_BWAMEM3:SAMTOOLS_INDEX' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/deduplicated" },
            mode: params.publish_dir_mode,
            pattern: "*.bai"
        ]
    }
}
