includeConfig "../modules/samtools_stats.config"
includeConfig "../modules/samtools_flagstat.config"
includeConfig "../modules/samtools_idxstats.config"

process {
    withName: 'NFCORE_METHYLSEQ:METHYLSEQ:FASTQ_ALIGN_DEDUP_UMI_BWAMEM3:SAMTOOLS_DICT' {
        publishDir = [ enabled: false ]
    }

    withName: 'NFCORE_METHYLSEQ:METHYLSEQ:FASTQ_ALIGN_DEDUP_UMI_BWAMEM3:FGUMI_RUNALL' {
        ext.args = { [
            // The unmapped reads' read group replaces the aligner's
            "--extract::read-group-id ${meta.id} --extract::platform ILLUMINA",
            // Without a read structure, the UMI is the last colon-separated field of the read name (e.g. BCL Convert).
            // Single-end samples take the first read structure only.
            params.umi_read_structure
                ? "--extract::read-structures ${params.umi_read_structure.tokenize(' ').take(meta.single_end ? 1 : 2).join(' ')}"
                : "--extract::read-structures ${meta.single_end ? '+T' : '+T +T'} --extract::extract-umis-from-read-names",
            // fgumi feeds the aligner interleaved FASTQ on stdin and replaces {ref} and {threads}
            "--aligner::command \"bwa-mem3 mem --bam=0 ${params.taps ? '--meth=taps' : '--meth'} ${meta.single_end ? '' : '-p'} -K 150000000 -t {threads} {ref} /dev/stdin\"",
        ].join(' ') }
        ext.prefix = { "${meta.id}.template" }
        publishDir = [ enabled: false ]
    }

    withName: 'NFCORE_METHYLSEQ:METHYLSEQ:FASTQ_ALIGN_DEDUP_UMI_BWAMEM3:FGUMI_DEDUP' {
        // Keep every record, as Picard MarkDuplicates does: fgumi dedup otherwise drops unmapped and QC-fail templates
        ext.args = { "--strategy ${params.umi_dedup_strategy} --include-unmapped --include-non-pf-reads" }
        ext.prefix = { "${meta.id}.umi_dedup" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/deduplicated/fgumi_metrics" },
            mode: params.publish_dir_mode,
            pattern: "*.txt"
        ]
    }

    withName: 'NFCORE_METHYLSEQ:METHYLSEQ:FASTQ_ALIGN_DEDUP_UMI_BWAMEM3:FGUMI_SORT' {
        ext.args = '--order coordinate --write-index'
        ext.prefix = { (params.skip_deduplication || params.rrbs) ? "${meta.id}.sorted" : "${meta.id}.markdup.sorted" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/${(params.skip_deduplication || params.rrbs) ? 'alignments' : 'deduplicated'}" },
            mode: params.publish_dir_mode,
            pattern: "*.{bam,bai}"
        ]
    }
}
