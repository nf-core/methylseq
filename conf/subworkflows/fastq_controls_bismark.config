// Spike-in controls aligned on their own (FASTQ_CONTROLS_BISMARK): small jobs, nothing published under the aligner's
// folder, outputs in controls/. The library options come from the plain-name blocks in conf/modules.
process {
    withName: '.*FASTQ_CONTROLS_BISMARK:GUNZIP' {
        publishDir = [enabled: false]
    }
    withName: '.*FASTQ_CONTROLS_BISMARK:BISMARK_GENOMEPREPARATION' {
        ext.args = '--bowtie2'
        publishDir = [enabled: false]
    }
    withName: '.*FASTQ_CONTROLS_BISMARK:BWAMEM3_INDEX' {
        publishDir = [enabled: false]
    }
    withName: '.*FASTQ_CONTROLS_BISMARK:BISMARK_ALIGN' {
        ext.prefix = 'controls'
        publishDir = [
            [
                path: { "${params.outdir}/controls/alignments" },
                mode: params.publish_dir_mode,
                pattern: "*report.txt"
            ],
            [
                path: { "${params.outdir}/controls/alignments" },
                mode: params.publish_dir_mode,
                pattern: "*.bam",
                enabled: params.save_align_intermeds
            ]
        ]
    }
    withName: '.*FASTQ_CONTROLS_BISMARK:BISMARK_METHYLATIONEXTRACTOR' {
        publishDir = [
            path: { "${params.outdir}/controls/methylation_calls" },
            mode: params.publish_dir_mode,
            pattern: "*_splitting_report.txt"
        ]
    }
    withName: '.*FASTQ_CONTROLS_BISMARK:BISMARK_COVERAGE2CYTOSINE' {
        ext.prefix = { "${meta.id}.controls" }
        publishDir = [
            path: { "${params.outdir}/controls/methylation_calls" },
            mode: params.publish_dir_mode,
            pattern: "*{CX_report.txt.gz,cytosine_context_summary.txt}"
        ]
    }
    withName: '.*FASTQ_CONTROLS_BISMARK:(GUNZIP|BISMARK_GENOMEPREPARATION|BISMARK_COVERAGE2CYTOSINE)' {
        cpus = 2
        memory = { 4.GB * task.attempt }
        time = { 2.h * task.attempt }
    }
    // The bwa-mem3 index keeps its module's memory, which scales with the FASTA
    withName: '.*FASTQ_CONTROLS_BISMARK:BWAMEM3_INDEX' {
        cpus = 2
        time = { 2.h * task.attempt }
    }
    // --control_reads 0 aligns every read, which takes as long as the main alignment
    withName: '.*FASTQ_CONTROLS_BISMARK:(BISMARK_ALIGN|BISMARK_METHYLATIONEXTRACTOR)' {
        cpus = { params.control_reads ? 2 : 8 }
        memory = { 4.GB * task.attempt }
        time = { (params.control_reads ? 2.h : 2.d) * task.attempt }
    }
}
